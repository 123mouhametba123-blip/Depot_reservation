{
    "name": "etudiant/reservation-salles",
    "description": "Application web de gestion des réservations de salles universitaires (projet ODC-P8).",
    "type": "project",
    "license": "MIT",
    "keywords": ["php", "oop", "mvc", "fastroute", "eloquent", "php-di"],
    "require": {
        "php": "^8.2",
        "nikic/fast-route": "^1.3",
        "respect/validation": "^2.4",
        "illuminate/database": "^12.0",
        "php-di/php-di": "^7.0",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "db:migrate": "php database/migrer.php",
        "db:seed": "php database/seed.php",
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
