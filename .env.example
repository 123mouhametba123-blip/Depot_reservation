# Copiez ce fichier vers .env et adaptez les valeurs à votre environnement.
# Ne versionnez JAMAIS le fichier .env (il contient des secrets).
# Sur Render (PostgreSQL) : DB_DRIVER=pgsql, et remplir host/port/base/user/pass du service Postgres.
APP_ENV=development
APP_DEBUG=true

DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=reservation_salles
DB_USERNAME=root
DB_PASSWORD=
