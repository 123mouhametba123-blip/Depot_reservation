# Copiez ce fichier vers .env et adaptez les valeurs à votre environnement.
# Ne versionnez JAMAIS le fichier .env (il contient des secrets).
APP_ENV=development
APP_DEBUG=true

DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=reservation_salles
DB_USERNAME=root
DB_PASSWORD=

# TiDB / hébergeurs exigeant TLS : DB_SSL=true (+ éventuellement DB_SSL_CA)
# DB_SSL=false
